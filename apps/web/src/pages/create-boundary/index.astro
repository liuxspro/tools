---
import Base from "@/layouts/base.astro";
import Tool from "@/components/create-boundary/tool";
import { HelpButton } from "@/components/create-boundary/help-dialog";
---

<Base title="地块边界文件制作">
  <div class="flex min-h-dvh flex-col lg:h-dvh lg:overflow-hidden">
    <header class="shrink-0 border-b border-border/80 bg-background">
      <div class="mx-auto flex h-14 w-full max-w-[1680px] items-center justify-between gap-4 px-4 sm:px-6">
        <div class="flex min-w-0 items-center gap-2.5">
          <img src="/favicon.svg" alt="" class="size-6" />
          <div class="flex min-w-0 items-baseline gap-2">
            <span class="truncate text-sm font-semibold">地块边界文件制作</span>
            <span class="hidden font-mono text-[11px] text-muted-foreground sm:inline">
              create-boundary
            </span>
          </div>
        </div>
        <div class="flex shrink-0 items-center gap-4">
          <HelpButton client:load />
          <a
            href="https://www.npmjs.com/package/@liuxspro/create-boundary-cli"
            target="_blank"
            rel="noreferrer"
            class="text-xs text-muted-foreground transition-colors hover:text-foreground"
          >
            命令行版本
          </a>
        </div>
      </div>
    </header>

    <main class="min-h-0 flex-1">
      <Tool client:load />
    </main>
  </div>
</Base>
