{
  "name": "@liuxspro/create-boundary-cli",
  "version": "0.2.0",
  "description": "生成地块调查边界 Shapefile ZIP 的命令行工具，包装 @liuxspro/create-boundary",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuxspro/tools.git",
    "directory": "apps/cli"
  },
  "homepage": "https://tools.liuxs.pro/create-boundary/",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "create-boundary": "dist/cli.js"
  },
  "files": [
    "dist",
    "examples"
  ],
  "keywords": [
    "boundary",
    "shapefile",
    "gis",
    "dbf",
    "cli"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rolldown -c",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && node --test tests/cli.test.ts",
    "prepack": "pnpm run typecheck && pnpm run build",
    "start": "node dist/cli.js"
  },
  "devDependencies": {
    "@liuxspro/create-boundary": "jsr:^0.4.0",
    "@types/node": "^22.20.1",
    "jszip": "^3.10.2",
    "rolldown": "^1.2.7",
    "typescript": "^7.0.2"
  }
}
